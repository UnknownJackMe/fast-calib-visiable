Panels:
  - Class: rviz_common/Displays
    Name: 显示
  - Class: rviz_common/Views
    Name: 视图
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.55
      Class: rviz_default_plugins/Grid
      Color: 90; 90; 90
      Enabled: true
      Name: XY 网格
      Plane: XY
      Plane Cell Count: 24
      Reference Frame: livox_frame
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 1.0
      Name: LiDAR 坐标轴
      Reference Frame: livox_frame
      Value: true
    - Alpha: 0.75
      Class: rviz_default_plugins/PointCloud2
      Color: 190; 190; 190
      Color Transformer: FlatColor
      Enabled: true
      Name: 完整静态点云预览
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /static_cloud_preview
      Use Fixed Frame: true
      Value: true
    - Alpha: 1.0
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 215; 40
      Color Transformer: FlatColor
      Enabled: true
      Name: 多边形原始选中点
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 4
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /board_polygon_selected_points
      Use Fixed Frame: true
      Value: true
    - Alpha: 1.0
      Class: rviz_default_plugins/PointCloud2
      Color: 40; 220; 80
      Color Transformer: FlatColor
      Enabled: true
      Name: 选中的标定板
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /selected_board_cloud
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 标定板轮廓与法向
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /selected_board_markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 18; 18; 18
    Fixed Frame: livox_frame
    Frame Rate: 15
  Name: 根节点
  Tools:
    - Class: fast_calib/BoardPolygonSelection
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.5
      Focal Point:
        X: 2.6
        Y: 0.0
        Z: 0.9
      Name: 当前视图
      Pitch: 0.25
      Target Frame: livox_frame
      Yaw: 2.8
Window Geometry:
  Height: 900
  Width: 1400
